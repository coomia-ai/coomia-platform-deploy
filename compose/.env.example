# Coomia AI Data Platform - Docker Compose configuration template
# Copy to compose/.env or run: bash scripts/init-config.sh
# Keep compose/.env outside version control and chmod it to 0600.

# Product images. The release publisher must fill immutable RepoDigests.
PLATFORM_API_IMAGE=
PLATFORM_UI_IMAGE=
FLINK_LOCAL_IMAGE=

# Infrastructure images. Fill the approved immutable RepoDigests for the release.
POSTGRES_IMAGE=
MINIO_IMAGE=
MINIO_MC_IMAGE=
NESSIE_IMAGE=
TUGRAPH_IMAGE=
DORIS_FE_IMAGE=
DORIS_BE_IMAGE=
KAFKA_IMAGE=
REDIS_IMAGE=

# Platform database. Passwords generated by init-config.sh use URL-safe hex.
POSTGRES_USER=platform
POSTGRES_PASSWORD=
POSTGRES_DB=platform
DATABASE_URL=

# Infrastructure credentials.
MINIO_ROOT_USER=coomiaadmin
MINIO_ROOT_PASSWORD=
DORIS_USER=root
DORIS_PASSWORD=
REDIS_PASSWORD=
TUGRAPH_USER=admin
TUGRAPH_PASSWORD=

# Application signing secrets. They must be different and at least 32 characters.
JWT_SECRET=
DELIVERY_REPORT_HMAC_SECRET=
DELIVERY_REPORT_HMAC_KEY_ID=v1
DELIVERY_REPORT_HMAC_PREVIOUS_KEYS={}
MDS_FLINK_CONTROL_TOKEN=

# License mode: online or offline.
LICENSE_MODE=online
LICENSE_SERVER_URL=https://coomia.com
COOMIA_LICENSE_PUBLIC_KEY_FILE=

# Customer-owned private directories. Use absolute Linux paths.
MDS_FLINK_ARTIFACT_DIR=
MDS_GENERATED_CONFIG_DIR=
MDS_INTAKE_SECRETS_DIR=
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Public application endpoints. Infrastructure ports are not exposed by default.
BIND_ADDRESS=0.0.0.0
PLATFORM_UI_PORT=3000
PLATFORM_API_PORT=8050
CORS_ORIGINS=http://localhost:3000
INSTALL_WAIT_TIMEOUT_SECONDS=600

# Internal network. Change these values if 172.25.0.0/16 conflicts with the host.
MDS_DATA_SUBNET=172.25.0.0/16
MDS_DATA_GATEWAY=172.25.0.1
DORIS_FE_IP=172.25.0.140
DORIS_BE_IP=172.25.0.141
